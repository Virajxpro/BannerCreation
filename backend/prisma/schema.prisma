generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Banner {
  id           String   @id @default(uuid())
  title        String
  percentageOff Int
  gradientType String
  categories   String[]
  bannerUrl    String
  createdAt    DateTime @default(now())
}
